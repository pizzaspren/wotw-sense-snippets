#name("Sense Core")
#description("API for detecting specific pickups on the map. Does not detect anything by itself.")

!include("math_lib", math_hypot, math_abs, math_mod, math_trunc, math_return)

!config_float_range(sense_distance, 400.0, 1.0, 9999.0, "Sense distance", "How far away Sense should start detecting things")
!config_float_range(sense_timer_delay, 5.0, 0.1, 600.0, "Re-scan delay (seconds)", "Time between full map re-scans for better accuracy when multiple pickups are nearby")
!config_boolean(sense_debug, false, "Debug", "Debug purposes")
!export(sense_debug)

!timer(sense_timer_enabled, sense_timer)
!export(sense_timer_enabled)

!let(sense_shortest_distance, "sense_shortest_distance")
!let(sense_longest_distance, 10000.0)  // Surely that's enough
!let(sense_pickup_x, "sense_pickup_x")
!let(sense_pickup_y, "sense_pickup_y")
!let(sense_pickup_xy, "sense_pickup_xy")
!export(sense_pickup_xy)
!let(sense_detect_unavailable, "sense_detect_unavailable")
!export(sense_detect_unavailable)

!let(sense_message, "sense_message")
on spawn {
    free_message(sense_message, "Sense: Nothing")
    set_message_corner(sense_message, BottomLeft)
    store(sense_timer_enabled, true)  // TODO: A way to turn this off ingame?
    sense_detect_pickups()  // First one is free
}
on sense_timer > sense_timer_delay if is_in_rectangle(-2100, -4700, 2500, -3300) {
    sense_detect_pickups()
    store(sense_timer, 0)
}

on tick {
    sense_tick()
    if get_float(sense_shortest_distance) > sense_distance        set_message_text(sense_message, "")
    if get_float(sense_shortest_distance) / sense_distance <=1    set_message_text(sense_message, "Sense: *Far*")
    if get_float(sense_shortest_distance) / sense_distance < 0.5  set_message_text(sense_message, "Sense: $Nearby$")
    if get_float(sense_shortest_distance) / sense_distance < 0.3  set_message_text(sense_message, "Sense: #Close#")
    if get_float(sense_shortest_distance) / sense_distance < 0.1  set_message_text(sense_message, "Sense: @Very close@")
}

fun sense_detect_pickups(){
}
!export(sense_detect_pickups)

fun sense_tick(){
    set_float(sense_shortest_distance, sense_longest_distance)
}
!export(sense_tick)

// Updates the float `sense_shortest_distance` if the distance from Ori to the pickup is lower
fun sense_update_closest(candidate_xy: Integer){
    if candidate_xy != 0 {
        sense_split_pickup_position(candidate_xy)
        math_hypot(get_float(sense_pickup_x) - player.positionX, get_float(sense_pickup_y) - player.positionY)
        if get_float(math_return) < get_float(sense_shortest_distance) set_float(sense_shortest_distance, get_float(math_return))
    }
}
!export(sense_update_closest)

// Positions stored as int(str(x) + str(-y)). Y is always within -3500..-4700 for the pickups in WotW map, which is why we can omit the sign for more compact storage
// This function reverses that process to extract X and Y
fun sense_split_pickup_position(pickup_xy: Integer) {   
    math_abs(pickup_xy)
    math_mod(get_float(math_return), 10000)  // Extract Y position as positive value
    set_float(sense_pickup_y, 0 - get_float(math_return))  // Invert Y position. Y is always within -3500..-4700 for the pickups in WotW map

    math_trunc(pickup_xy / 10000)  // Recovers signed X without decimals from Y
    set_float(sense_pickup_x, get_float(math_return))
}

