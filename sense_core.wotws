!export(sense_pickup_search)

// Updates `sense_search_closest_xy` and `sense_search_closest_dist` if `candidate_xy` is closer to Ori's current position
fun sense_pickup_search_closest(candidate_xy: Integer){
    if candidate_xy != 0 {
        sense_split_pickup_position(candidate_xy)
        math_hypot(get_float(sense_pickup_x) - player.positionX, get_float(sense_pickup_y) - player.positionY)
        if get_float(math_return) < get_float("sense_search_closest_dist") {
            set_integer("sense_search_closest_xy", candidate_xy)
            set_float("sense_search_closest_dist", get_float(math_return))
        }
    }
}

// FIXME once we can detect if other snippets are included
!state(area_hints_included, Boolean)  // Uses actual skill names
!state(key_hints_included, Boolean)  // Uses white or green for skills ("" / "$")
// !state(knowledge_hints_included, Boolean)  // Does not place anything on pickups
// !state(shrine_hints_included, Boolean)  // Does not place anything on pickups
!state(tree_hints_included, Boolean)  // Uses white or green for skills ("" / "$")
// !state(trial_hints_included, Boolean)  // Does not place anything on pickups
on spawn {
    // THIS IS VERY SKETCHY
    store(area_hints_included, string_contains(" - ", Marsh_LupoMap_item))  // Detects "Marsh Skills - " and "Marsh TPs - ". No config for individual maps means it's applied to all of them.
    store( key_hints_included, string_contains("Clean Water:", Shop_Opher_Slot11_item))  // U+00a0, not a space
    store(tree_hints_included, string_contains("Regenerate: ", Marsh_RegenerateTree_item))  // U+00a0, not a space
}

fun sense_check_trees(pickup_text: String, detect_unavailable: Boolean){
    // Do something about tree hints?
    if (detect_unavailable || Marsh.AncestralLightTree == false) && string_contains(pickup_text, Marsh_AncestralLightTree_item) sense_pickup_search_closest(-8404488)
    if (detect_unavailable || Marsh.RegenerateTree == false) && string_contains(pickup_text, Marsh_RegenerateTree_item) sense_pickup_search_closest(-5394406)
    if (detect_unavailable || Marsh.SwordTree == false) && string_contains(pickup_text, Marsh_SwordTree_item) sense_pickup_search_closest(-2964483)
    if (detect_unavailable || Marsh.DoubleJumpTree == false) && string_contains(pickup_text, Marsh_DoubleJumpTree_item) sense_pickup_search_closest(-5554551)
    if (detect_unavailable || Marsh.BowTree == false) && string_contains(pickup_text, Marsh_BowTree_item) sense_pickup_search_closest(-4574267)
    if (detect_unavailable || Hollow.DashTree == false) && string_contains(pickup_text, Hollow_DashTree_item) sense_pickup_search_closest(-694453)
    if (detect_unavailable || Hollow.BashTree == false) && string_contains(pickup_text, Hollow_BashTree_item) sense_pickup_search_closest(-204326)
    if (detect_unavailable || Glades.AncestralLightTree == false) && string_contains(pickup_text, Glades_AncestralLightTree_item) sense_pickup_search_closest(-3684158)
    if (detect_unavailable || Wellspring.GrappleTree == false) && string_contains(pickup_text, Wellspring_GrappleTree_item) sense_pickup_search_closest(-13093905)
    if (detect_unavailable || Woods.LaunchTree == false) && string_contains(pickup_text, Woods_LaunchTree_item) sense_pickup_search_closest(13633815)
    if (detect_unavailable || Reach.GrenadeTree == false) && string_contains(pickup_text, Reach_GrenadeTree_item) sense_pickup_search_closest(-1063934)
    if (detect_unavailable || Depths.FlashTree == false) && string_contains(pickup_text, Depths_FlashTree_item) sense_pickup_search_closest(7764541)
    if (detect_unavailable || Pools.WaterDashTree == false) && string_contains(pickup_text, Pools_WaterDashTree_item) sense_pickup_search_closest(-14304082)
    if (detect_unavailable || Wastes.BurrowTree == false) && string_contains(pickup_text, Wastes_BurrowTree_item) sense_pickup_search_closest(15833930)
}

fun sense_check_twillen(pickup_text: String, detect_unavailable: Boolean){
    if (detect_unavailable || Shop.Twillen.Slot1 == false) && string_contains(pickup_text, Shop_Twillen_Slot1_item) sense_pickup_search_twillen()
    if (detect_unavailable || Shop.Twillen.Slot2 == false) && string_contains(pickup_text, Shop_Twillen_Slot2_item) sense_pickup_search_twillen()
    if (detect_unavailable || Shop.Twillen.Slot3 == false) && string_contains(pickup_text, Shop_Twillen_Slot3_item) sense_pickup_search_twillen()
    if (detect_unavailable || Shop.Twillen.Slot4 == false) && string_contains(pickup_text, Shop_Twillen_Slot4_item) sense_pickup_search_twillen()
    if (detect_unavailable || Shop.Twillen.Slot5 == false) && string_contains(pickup_text, Shop_Twillen_Slot5_item) sense_pickup_search_twillen()
    if (detect_unavailable || Shop.Twillen.Slot6 == false) && string_contains(pickup_text, Shop_Twillen_Slot6_item) sense_pickup_search_twillen()
    if (detect_unavailable || Shop.Twillen.Slot7 == false) && string_contains(pickup_text, Shop_Twillen_Slot7_item) sense_pickup_search_twillen()
    
    // Key hints changes this slot
    if key_hints_included == false && (detect_unavailable || Shop.Twillen.Slot8 == false) && string_contains(pickup_text, Shop_Twillen_Slot8_item) sense_pickup_search_twillen()
}
fun sense_pickup_search_twillen(){
    sense_pickup_search_closest(-2814238)
    sense_pickup_search_closest(-4104161)
}

fun sense_check_opher(pickup_text: String, detect_unavailable: Boolean){
