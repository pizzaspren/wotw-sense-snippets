    if (detect_unavailable || Shop.Opher.Slot2 == false) && string_contains(pickup_text, Shop_Opher_Slot2_item) sense_pickup_search_opher()
    if (detect_unavailable || Shop.Opher.Slot3 == false) && string_contains(pickup_text, Shop_Opher_Slot3_item) sense_pickup_search_opher()
    if (detect_unavailable || Shop.Opher.Slot4 == false) && string_contains(pickup_text, Shop_Opher_Slot4_item) sense_pickup_search_opher()
    if (detect_unavailable || Shop.Opher.Slot5 == false) && string_contains(pickup_text, Shop_Opher_Slot5_item) sense_pickup_search_opher()
    if (detect_unavailable || Shop.Opher.Slot6 == false) && string_contains(pickup_text, Shop_Opher_Slot6_item) sense_pickup_search_opher()
    if (detect_unavailable || Shop.Opher.Slot7 == false) && string_contains(pickup_text, Shop_Opher_Slot7_item) sense_pickup_search_opher()
    if (detect_unavailable || Shop.Opher.Slot8 == false) && string_contains(pickup_text, Shop_Opher_Slot8_item) sense_pickup_search_opher()
    if (detect_unavailable || Shop.Opher.Slot9 == false) && string_contains(pickup_text, Shop_Opher_Slot9_item) sense_pickup_search_opher()
    if (detect_unavailable || Shop.Opher.Slot10 == false) && string_contains(pickup_text, Shop_Opher_Slot10_item) sense_pickup_search_opher()
    if (detect_unavailable || Shop.Opher.Slot12 == false) && string_contains(pickup_text, Shop_Opher_Slot12_item) sense_pickup_search_opher()

    // Key hints changes this slot
    if key_hints_included == false && (detect_unavailable || Shop.Opher.Slot11 == false) && string_contains(pickup_text, Shop_Opher_Slot11_item) sense_pickup_search_opher()
}
