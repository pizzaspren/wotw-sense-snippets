fun sense_check_lupo(pickup_text: String, detect_unavailable: Boolean){
    // Area hints changes these slots
    if area_hints_included == false {
        if (detect_unavailable || Shop.Lupo.Slot1 == false) && string_contains(pickup_text, Shop_Lupo_Slot1_item) sense_pickup_search_closest(-1734508)
        if (detect_unavailable || Shop.Lupo.Slot2 == false) && string_contains(pickup_text, Shop_Lupo_Slot2_item) sense_pickup_search_closest(-1734508)
    }
    // Key hints changes this slot
    if key_hints_included == false && (detect_unavailable || Shop.Lupo.Slot3 == false) && string_contains(pickup_text, Shop_Lupo_Slot3_item) sense_pickup_search_closest(-1734508)

    // Area hints changes these slots
    if area_hints_included == false {
        if (detect_unavailable || Marsh.LupoMap == false) && string_contains(pickup_text, Marsh_LupoMap_item) sense_pickup_search_closest(-5894348)
        if (detect_unavailable || Burrows.LupoMap == false) && string_contains(pickup_text, Burrows_LupoMap_item) sense_pickup_search_closest(-8704555)
        if (detect_unavailable || Hollow.LupoMap == false) && string_contains(pickup_text, Hollow_LupoMap_item) sense_pickup_search_closest(-1464321)
        if (detect_unavailable || Wellspring.LupoMap == false) && string_contains(pickup_text, Wellspring_LupoMap_item) sense_pickup_search_closest(-11903861)
        if (detect_unavailable || Reach.LupoMap == false) && string_contains(pickup_text, Reach_LupoMap_item) sense_pickup_search_closest(-2753996)
        if (detect_unavailable || Depths.LupoMap == false) && string_contains(pickup_text, Depths_LupoMap_item) sense_pickup_search_closest(6824576)
        if (detect_unavailable || Pools.LupoMap == false) && string_contains(pickup_text, Pools_LupoMap_item) sense_pickup_search_closest(-13914167)
        if (detect_unavailable || Wastes.LupoMap == false) && string_contains(pickup_text, Wastes_LupoMap_item) sense_pickup_search_closest(16473899)
        if (detect_unavailable || Willow.LupoMap == false) && string_contains(pickup_text, Willow_LupoMap_item) sense_pickup_search_closest(4743859)
    }
}


!if sense_debug {
    !no_random_placement(Marsh.Spawn.LeftHF)
    on Marsh.Spawn.LeftHF skill(Bash)

    !let(sense_message_debug, "sense_message_debug")
    on spawn {
        free_message(sense_message_debug, "Sense debugging enabled")
        set_message_corner(sense_message_debug, TopLeft)
    }

    !augment_fun(sense_update_closest(candidate_xy: Integer), {
        set_message_text(sense_message_debug, "@Sense Debug@" + "\nplayer.positionX: " + player.positionX + "\nplayer.positionY: " + player.positionY + "\nsense_shortest_distance: " + get_float(sense_shortest_distance))
    })
    !augment_fun(sense_pickup_search_closest(candidate_xy: Integer), {
        if candidate_xy != 0 {
            sense_split_pickup_position(candidate_xy)
            math_hypot(get_float(sense_pickup_x) - player.positionX, get_float(sense_pickup_y) - player.positionY)
            if get_float(math_return) > get_float("sense_search_closest_dist") {
                item_message("@Sense debug@ - $sense_pickup_search_closest$" +
                            "\nx: " + to_string(get_float(sense_pickup_x)) +
                            "  y: " + to_string(get_float(sense_pickup_y)) +
                            "\nplayer.positionX: " + player.positionX +
                            "  player.positionY: " + player.positionY +
                            "\ndx: " + to_string(get_float(sense_pickup_x) - player.positionX) +
                            "  dy: " + to_string(get_float(sense_pickup_y) - player.positionY) +
                            "\nhypot: " + get_float(math_return) +
                            "\nclosest: " + to_string(get_float("sense_search_closest_dist")))
            }
            if get_float(math_return) < get_float("sense_search_closest_dist") {
                item_message("@Sense debug@ - $sense_pickup_search_closest$" +
                            "\nmath_return < sense_search_closest_dist (" + get_float(math_return) + " < " + get_float("sense_search_closest_dist") + ")")
            }
        }
    })
}
