// Finds the closest pickup containing the string within `pickup_text`.
// If `detect_unavailable`, it will also scan already-picked-up locations
fun sense_pickup_search(pickup_text: String, detect_unavailable: Boolean){
    set_integer("sense_search_closest_xy", 0)
    set_float("sense_search_closest_dist", sense_longest_distance)
    // Search and replace on pickups.csv
    // 1:
    // s: ^(Marsh|Burrows|Hollow|Glades|Wellspring|Pools|Woods|Depths|Wastes|Ruins|Willow|Reach|Shop)\.([a-zA-Z]*)\.?([a-zA-Z]*),(?:[^,]*,){4}\s(-?\d+)(?:\.\d+)?,\s-(\d+).*$
    // r:     if (detect_unavailable || $1.$2.$3 == false) && string_contains(pickup_text, $1_$2_$3_item) sense_pickup_search_closest($4$5)
    // 2: Work around mix of 3-part and 2-part names
    // s: _{2}item
    // r: _item
    // 3: Work around mix of 3-part and 2-part names
    // s: \.\s==
    // r:  ==
    if (detect_unavailable || Marsh.LeftPoolsPath.SL == false) && string_contains(pickup_text, Marsh_LeftPoolsPath_SL_item) sense_pickup_search_closest(-10144268)
    if (detect_unavailable || Marsh.Spawn.LeftLF == false) && string_contains(pickup_text, Marsh_Spawn_LeftLF_item) sense_pickup_search_closest(-9584313)
    if (detect_unavailable || Marsh.LongSwimSL == false) && string_contains(pickup_text, Marsh_LongSwimSL_item) sense_pickup_search_closest(-8374314)
