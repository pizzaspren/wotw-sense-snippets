#name("Sense (Gorlek Ore)")
#description("Detect nearby Gorlek Ore")
!tags("Sense (Gorlek Ore)")

!include("sense_core", sense_detect_pickups, sense_tick, sense_pickup_xy, sense_pickup_search, sense_update_closest)


!config_boolean(sense_detect_unavailable_ore, false, "Unavailable locations", "Whether Sense should detect Gorlek Ore in unavailable locations")
!config_boolean(sense_gorlek_ore, true, "Sense Gorlek Ore", "Whether to sense Gorlek Ore")

!if sense_gorlek_ore {
    !state(ore_PickupXY, Integer)
    !augment_fun(sense_detect_pickups(), detect_gorlek_ore())
    fun detect_gorlek_ore() {
        sense_pickup_search(gorlek_ore_string(), sense_detect_unavailable_ore)
        store(ore_PickupXY, get_integer(sense_pickup_xy))
    }
    !augment_fun(sense_tick(), sense_update_closest(ore_PickupXY))
    on change player.gorlekOre detect_gorlek_ore()
}
