#name("Sense (Skills)")
#description("Detect nearby skills")
!tags("Sense (Skills)")

!include("sense_core", sense_detect_pickups, sense_tick, sense_pickup_xy, sense_pickup_search, sense_update_closest, sense_debug)


!config_boolean(sense_detect_unavailable_skills, false, "Unavailable locations", "Whether Sense should detect skills in unavailable locations")
!config_boolean(sense_bash, true, "Sense Bash", "Whether to sense Bash")
!config_boolean(sense_blaze, true, "Sense Blaze", "Whether to sense Blaze")
!config_boolean(sense_bow, true, "Sense Bow", "Whether to sense Bow")
!config_boolean(sense_burrow, true, "Sense Burrow", "Whether to sense Burrow")
!config_boolean(sense_cleanwater, true, "Sense Clean Water", "Whether to sense Clean Water")
!config_boolean(sense_dash, true, "Sense Dash", "Whether to sense Dash")
!config_boolean(sense_doublejump, true, "Sense Double Jump", "Whether to sense Double Jump")
!config_boolean(sense_flap, true, "Sense Flap", "Whether to sense Flap")
!config_boolean(sense_flash, true, "Sense Flash", "Whether to sense Flash")
!config_boolean(sense_glide, true, "Sense Glide", "Whether to sense Glide")
!config_boolean(sense_grapple, true, "Sense Grapple", "Whether to sense Grapple")
!config_boolean(sense_grenade, true, "Sense Grenade", "Whether to sense Grenade")
!config_boolean(sense_hammer, true, "Sense Hammer", "Whether to sense Hammer")
!config_boolean(sense_launch, true, "Sense Launch", "Whether to sense Launch")
!config_boolean(sense_regenerate, true, "Sense Regenerate", "Whether to sense Regenerate")
!config_boolean(sense_sentry, true, "Sense Sentry", "Whether to sense Sentry")
!config_boolean(sense_shuriken, true, "Sense Shuriken", "Whether to sense Shuriken")
!config_boolean(sense_spear, true, "Sense Spear", "Whether to sense Spear")
!config_boolean(sense_sword, true, "Sense Sword", "Whether to sense Sword")
!config_boolean(sense_waterbreath, true, "Sense Water Breath", "Whether to sense Water Breath")
!config_boolean(sense_waterdash, true, "Sense Water Dash", "Whether to sense Water Dash")

!if sense_bash {
    !state(bash_PickupXY, Integer)
    !augment_fun(sense_detect_pickups(), detect_bash())
    fun detect_bash() {
        sense_pickup_search(skill_string(Bash), sense_detect_unavailable_skills)
        store(bash_PickupXY, get_integer(sense_pickup_xy))
    }
    !augment_fun(sense_tick(), sense_update_closest(bash_PickupXY))
    on skills.bash detect_bash()
}

